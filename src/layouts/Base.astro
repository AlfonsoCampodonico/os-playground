---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, routeOf, ui, LANGS, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const fullTitle = title ? `${title} · ${t.siteName}` : `${t.siteName} · ${t.tagline}`;
const route = routeOf(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={href(route, l)} />)}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;0,900;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <script is:inline>
      // Resolve the theme before first paint: saved choice, else the OS setting.
      (() => {
        const root = document.documentElement;
        const mq = matchMedia('(prefers-color-scheme: dark)');
        const read = () => {
          try { return localStorage.getItem('theme') || 'system'; } catch { return 'system'; }
        };
        const apply = () => {
          const pref = read();
          root.dataset.themePref = pref;
          root.dataset.theme = pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref;
        };
        apply();
        mq.addEventListener('change', apply);
        window.__setTheme = (pref) => {
          try { localStorage.setItem('theme', pref); } catch {}
          apply();
        };
      })();
      // On an entry visit, send the student to the language they picked last time.
      (() => {
        let saved;
        try { saved = localStorage.getItem('lang'); } catch {}
        const here = document.documentElement.dataset.lang;
        const internal = document.referrer && new URL(document.referrer).origin === location.origin;
        if (!saved || saved === here || internal) return;
        const alt = document.querySelector('link[rel="alternate"][hreflang="' + saved + '"]');
        if (alt) location.replace(alt.href + location.search + location.hash);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header lang={lang} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
