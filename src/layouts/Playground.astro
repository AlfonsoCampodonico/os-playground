---
import Base from './Base.astro';
import { href, ui, type Lang } from '../lib/i18n';
import { SECTIONS, playground, neighbours } from '../lib/playgrounds';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = ui[lang];
const meta = playground(slug);
const section = SECTIONS.find((s) => s.id === meta.section)!;
const { prev, next } = neighbours(slug);
---

<Base lang={lang} title={meta.title[lang]} description={meta.blurb[lang]}>
  <div class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 sm:pt-14">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[11.5px] font-medium uppercase tracking-[0.07em] text-ink-3">
      <a href={`${href('/', lang)}#${section.id}`} class="hover:text-accent transition-colors">{section.title[lang]}</a>
      <span aria-hidden="true">·</span>
      <span>{t.week} {meta.week}</span>
      {
        meta.ostep && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              {t.ostepChapter} {meta.ostep}
            </span>
          </>
        )
      }
    </div>
    <h1 class="mt-3 font-serif text-[38px] leading-[1.05] tracking-[-0.015em] sm:text-[52px]">{meta.title[lang]}</h1>
    <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-2">{meta.lede[lang]}</p>
    {
      meta.ostepSim && (
        <p class="mt-4 inline-flex flex-wrap items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-[12.5px] text-ink-2">
          <span class="size-1.5 rounded-full bg-ok" />
          {t.sameAsOstep}: <span class="font-mono text-[12px] text-ink">{meta.ostepSim}</span>
        </p>
      )
    }
  </div>

  <div class="mx-auto mt-8 max-w-7xl px-4 sm:px-6">
    <slot />
  </div>

  <nav class="mx-auto mt-16 grid max-w-7xl gap-3 px-4 sm:grid-cols-2 sm:px-6" aria-label={t.allTopics}>
    {
      prev ? (
        <a href={href(`/${prev.slug}`, lang)} class="group rounded-2xl border border-line bg-surface p-5 transition hover:border-line-strong hover:shadow-panel">
          <div class="font-mono text-[11px] uppercase tracking-[0.07em] text-ink-3">← {t.prev}</div>
          <div class="mt-1 font-serif text-[22px] group-hover:text-accent transition-colors">{prev.title[lang]}</div>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={href(`/${next.slug}`, lang)} class="group rounded-2xl border border-line bg-surface p-5 text-right transition hover:border-line-strong hover:shadow-panel">
          <div class="font-mono text-[11px] uppercase tracking-[0.07em] text-ink-3">{t.next} →</div>
          <div class="mt-1 font-serif text-[22px] group-hover:text-accent transition-colors">{next.title[lang]}</div>
        </a>
      )
    }
  </nav>
</Base>
