---
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="mt-20 border-t border-line">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-[12.5px] text-ink-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="max-w-xl">{t.independent}</p>
    <div class="flex shrink-0 gap-4">
      <a class="hover:text-ink transition-colors" href="https://fisop.github.io/website/" rel="noopener">{t.courseSite} ↗</a>
      <a class="hover:text-ink transition-colors" href="https://pages.cs.wisc.edu/~remzi/OSTEP/" rel="noopener">OSTEP ↗</a>
    </div>
  </div>
</footer>
