---
/** Small animated illustration for each playground card; animates on card hover. */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const bars = [
  [0, 70, 'var(--c1)'],
  [70, 40, 'var(--c2)'],
  [110, 30, 'var(--c1)'],
  [140, 60, 'var(--c3)'],
  [200, 40, 'var(--c2)'],
  [240, 50, 'var(--c4)'],
] as const;
---

<svg viewBox="0 0 320 128" class="glyph absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true" data-slug={slug}>
  {
    slug === 'syscalls' && (
      <g font-family="JetBrains Mono, monospace" font-size="10">
        <rect x="40" y="18" width="240" height="40" rx="8" fill="var(--surface)" stroke="var(--line-strong)" />
        <rect x="40" y="70" width="240" height="40" rx="8" fill="var(--accent-soft)" stroke="var(--accent)" stroke-opacity=".4" />
        <text x="52" y="42" fill="var(--ink-3)">user</text>
        <text x="52" y="94" fill="var(--accent)">kernel</text>
        <circle class="mv-trap" cx="160" cy="38" r="6" fill="var(--accent)" />
        <text x="212" y="42" fill="var(--ink-2)">write()</text>
      </g>
    )
  }
  {
    slug === 'fork' && (
      <g stroke="var(--line-strong)" stroke-width="1.5" font-family="JetBrains Mono, monospace" font-size="9">
        <line x1="160" y1="30" x2="110" y2="66" />
        <line x1="160" y1="30" x2="210" y2="66" />
        <line class="grow" x1="110" y1="66" x2="80" y2="100" />
        <line class="grow" x1="210" y1="66" x2="240" y2="100" />
        <circle cx="160" cy="30" r="11" fill="var(--c1)" stroke="none" />
        <circle cx="110" cy="66" r="10" fill="var(--c2)" stroke="none" />
        <circle cx="210" cy="66" r="10" fill="var(--c3)" stroke="none" />
        <circle class="pop" cx="80" cy="100" r="9" fill="var(--c4)" stroke="none" />
        <circle class="pop" cx="240" cy="100" r="9" fill="var(--c5)" stroke="none" />
      </g>
    )
  }
  {
    slug === 'pipes' && (
      <g font-family="JetBrains Mono, monospace" font-size="10">
        {['ls', 'grep', 'out'].map((n, i) => (
          <>
            <rect x={36 + i * 96} y="44" width="56" height="40" rx="8" fill="var(--surface)" stroke="var(--line-strong)" />
            <text x={64 + i * 96} y="68" text-anchor="middle" fill="var(--ink-2)">{n}</text>
          </>
        ))}
        <line class="flow" x1="92" y1="64" x2="132" y2="64" stroke="var(--accent)" stroke-width="3" stroke-dasharray="4 5" />
        <line class="flow" x1="188" y1="64" x2="228" y2="64" stroke="var(--accent)" stroke-width="3" stroke-dasharray="4 5" />
      </g>
    )
  }
  {
    slug === 'scheduling' && (
      <g>
        {bars.map(([x, w, c], i) => (
          <rect class="bar" style={`--d:${i * 70}ms`} x={20 + x} y={32 + (i % 3) * 24} width={w - 3} height="18" rx="4" fill={c} />
        ))}
        <line x1="20" y1="110" x2="300" y2="110" stroke="var(--line-strong)" />
      </g>
    )
  }
  {
    slug === 'address-translation' && (
      <g font-family="JetBrains Mono, monospace" font-size="11">
        {[...'0110'].map((b, i) => (
          <>
            <rect x={30 + i * 18} y="30" width="16" height="22" rx="3" fill="var(--accent-soft)" />
            <text x={38 + i * 18} y="45" text-anchor="middle" fill="var(--accent)">{b}</text>
          </>
        ))}
        {[...'1010'].map((b, i) => (
          <>
            <rect x={106 + i * 18} y="30" width="16" height="22" rx="3" fill="var(--sunken)" stroke="var(--line)" />
            <text x={114 + i * 18} y="45" text-anchor="middle" fill="var(--ink-2)">{b}</text>
          </>
        ))}
        <path class="flow" d="M 60 56 C 60 90, 200 60, 200 84" fill="none" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 4" />
        {[...'1101'].map((b, i) => (
          <>
            <rect x={150 + i * 18} y="84" width="16" height="22" rx="3" fill="var(--info-soft)" />
            <text x={158 + i * 18} y="99" text-anchor="middle" fill="var(--info)">{b}</text>
          </>
        ))}
        {[...'1010'].map((b, i) => (
          <>
            <rect x={226 + i * 18} y="84" width="16" height="22" rx="3" fill="var(--sunken)" stroke="var(--line)" />
            <text x={234 + i * 18} y="99" text-anchor="middle" fill="var(--ink-2)">{b}</text>
          </>
        ))}
      </g>
    )
  }
  {
    slug === 'tlb' && (
      <g font-family="JetBrains Mono, monospace" font-size="10">
        {[0, 1, 2, 3].map((i) => (
          <>
            <rect class:list={[i === 1 && 'hit']} x={40 + i * 62} y="40" width="54" height="48" rx="8" fill="var(--surface)" stroke="var(--line-strong)" />
            <text x={67 + i * 62} y="60" text-anchor="middle" fill="var(--ink-3)">VPN {i * 3 + 1}</text>
            <text x={67 + i * 62} y="76" text-anchor="middle" fill="var(--ink-2)">→ {(i * 37 + 11) % 64}</text>
          </>
        ))}
      </g>
    )
  }
  {
    slug === 'page-replacement' && (
      <g font-family="JetBrains Mono, monospace" font-size="12">
        {[7, 0, 1, 2].map((p, i) => (
          <>
            <rect class:list={[i === 2 && 'evict']} x={70 + i * 48} y="38" width="40" height="52" rx="8" fill="var(--surface)" stroke="var(--line-strong)" />
            <text x={90 + i * 48} y="69" text-anchor="middle" fill="var(--ink)">{p}</text>
          </>
        ))}
      </g>
    )
  }
  {
    slug === 'locks' && (
      <g font-family="JetBrains Mono, monospace" font-size="9">
        <line x1="30" y1="44" x2="290" y2="44" stroke="var(--line)" />
        <line x1="30" y1="88" x2="290" y2="88" stroke="var(--line)" />
        {[0, 1, 2].map((i) => <rect class="t1" style={`--d:${i * 120}ms`} x={40 + i * 74} y="36" width="34" height="16" rx="4" fill="var(--c2)" />)}
        {[0, 1, 2].map((i) => <rect class="t2" style={`--d:${i * 120 + 60}ms`} x={77 + i * 74} y="80" width="34" height="16" rx="4" fill="var(--c1)" />)}
        <g transform="translate(268 54)">
          <rect x="0" y="8" width="18" height="14" rx="3" fill="var(--accent)" />
          <path class="shackle" d="M 4 8 V 4 a 5 5 0 0 1 10 0 V 8" fill="none" stroke="var(--accent)" stroke-width="2.2" />
        </g>
      </g>
    )
  }
  {
    slug === 'filesystem' && (
      <g>
        {Array.from({ length: 32 }, (_, i) => (
          <rect
            class:list={[[3, 4, 9, 17, 18, 25].includes(i) && 'used']}
            style={`--d:${(i % 8) * 40}ms`}
            x={40 + (i % 16) * 15}
            y={i < 16 ? 40 : 66}
            width="12"
            height="20"
            rx="2.5"
            fill="var(--surface)"
            stroke="var(--line-strong)"
          />
        ))}
      </g>
    )
  }
  {
    slug === 'virtualization' && (
      <g font-family="JetBrains Mono, monospace" font-size="9">
        <rect x="50" y="16" width="220" height="96" rx="10" fill="var(--surface)" stroke="var(--line-strong)" />
        <rect class="guest" x="66" y="30" width="188" height="56" rx="8" fill="var(--accent-soft)" stroke="var(--accent)" stroke-opacity=".5" />
        <rect x="82" y="42" width="70" height="30" rx="6" fill="var(--surface)" stroke="var(--line-strong)" />
        <text x="117" y="61" text-anchor="middle" fill="var(--ink-2)">app</text>
        <text x="200" y="61" text-anchor="middle" fill="var(--accent)">guest OS</text>
        <text x="160" y="104" text-anchor="middle" fill="var(--ink-3)">hypervisor</text>
      </g>
    )
  }
  {
    slug === 'kubernetes' && (
      <g font-family="JetBrains Mono, monospace" font-size="9">
        <rect x="104" y="10" width="112" height="30" rx="8" fill="var(--accent-soft)" stroke="var(--accent)" stroke-opacity=".5" />
        <text x="160" y="29" text-anchor="middle" fill="var(--accent)">control plane</text>
        {[0, 1, 2].map((i) => (
          <>
            <path class="flow" d={`M160 40 L${88 + i * 72} 62`} stroke="var(--line-strong)" stroke-dasharray="3 3" fill="none" />
            <rect x={56 + i * 72} y="62" width="64" height="54" rx="8" fill="var(--surface)" stroke="var(--line-strong)" />
            <rect class:list={[i === 2 && 'pop']} x={64 + i * 72} y="72" width="22" height="16" rx="4" fill="var(--c2)" fill-opacity=".6" />
            {i < 2 && <rect x={90 + i * 72} y="72" width="22" height="16" rx="4" fill="var(--c1)" fill-opacity=".6" />}
            <text x={88 + i * 72} y="106" text-anchor="middle" fill="var(--ink-3)">node-{i + 1}</text>
          </>
        ))}
      </g>
    )
  }
</svg>

<style>
  .glyph * {
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1), fill 300ms, opacity 300ms;
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.card:hover) .mv-trap { transform: translateY(52px); }
  :global(.card:hover) .pop { transform: scale(1.25); }
  .grow { stroke-dasharray: 60; stroke-dashoffset: 0; }
  :global(.card:hover) .grow { animation: draw 600ms ease-out; }
  .flow { animation: flow 1.6s linear infinite paused; }
  :global(.card:hover) .flow { animation-play-state: running; }
  :global(.card:hover) .bar { animation: barIn 500ms cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: var(--d); transform-origin: left center; }
  :global(.card:hover) .hit { fill: var(--ok-soft); stroke: var(--ok); }
  :global(.card:hover) .evict { fill: var(--bad-soft); stroke: var(--bad); transform: translateY(-6px); }
  :global(.card:hover) .t1, :global(.card:hover) .t2 { animation: barIn 450ms both; animation-delay: var(--d); transform-origin: left center; }
  :global(.card:hover) .shackle { transform: translateY(-3px); }
  :global(.card:hover) .used { fill: var(--accent); stroke: var(--accent); transition-delay: var(--d); }
  :global(.card:hover) .guest { transform: scale(1.03); }
  @keyframes flow { to { stroke-dashoffset: -18; } }
  @keyframes draw { from { stroke-dashoffset: 60; } }
  @keyframes barIn { from { transform: scaleX(0); } }
</style>
