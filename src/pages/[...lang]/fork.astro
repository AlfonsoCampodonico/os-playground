---
import Playground from '../../layouts/Playground.astro';
import ForkPlayground from '../../playgrounds/fork/Fork';
import { langPaths, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---

<Playground lang={lang} slug="fork">
  <ForkPlayground client:load lang={lang} />
</Playground>
