---
import Playground from '../../layouts/Playground.astro';
import TlbPlayground from '../../playgrounds/tlb/Tlb';
import { langPaths, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---

<Playground lang={lang} slug="tlb">
  <TlbPlayground client:load lang={lang} />
</Playground>
