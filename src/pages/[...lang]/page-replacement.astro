---
import Playground from '../../layouts/Playground.astro';
import PageReplacementPlayground from '../../playgrounds/page-replacement/PageReplacement';
import { langPaths, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---

<Playground lang={lang} slug="page-replacement">
  <PageReplacementPlayground client:load lang={lang} />
</Playground>
