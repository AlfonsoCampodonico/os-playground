---
import Playground from '../../layouts/Playground.astro';
import LocksPlayground from '../../playgrounds/locks/Locks';
import { langPaths, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---

<Playground lang={lang} slug="locks">
  <LocksPlayground client:load lang={lang} />
</Playground>
